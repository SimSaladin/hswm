cabal-version:      3.14
name:               pixman-bindings
version:            0.1.0.0
-- synopsis:
-- description:
license:            BSD-3-Clause
license-file:       LICENSE
author:             Samuli Thomasson
maintainer:         samuli.thomasson@pm.me
-- copyright:
category:           Graphics
--build-type:         Hooks
build-type:         Custom
extra-doc-files:    CHANGELOG.md
-- extra-source-files:
tested-with:
    GHC == 9.14.1

flag pkg-config
    description: Use pkgconfig to to resolve C dependencies
    manual: True
    default: True

flag build-tool-depends
    description: Use build-tool-depends for hs-bindgen-cli
    manual: True
    default: True

common warnings
    ghc-options: -Wall -Wunused-packages

custom-setup
    setup-depends:
          base             >=4.21 && <5
        , Cabal            >=3.14 && <3.18
        , Cabal-hooks      >=3.14 && <3.18
        , hs-bindgen-hooks

library
    import: warnings
    exposed-modules:
          Pixman
    build-depends:
          base                >=4.21 && <5
        , data-default       ^>=0.8
        , deepseq            ^>=1.5
        , hs-bindgen-runtime  >=0.1  && <0.2
        , c-expr-runtime      >=0.1  && <0.2
    hs-source-dirs:
          src
    default-language: GHC2024

    if flag(pkg-config)
        pkgconfig-depends: pixman-1
    else
        extra-libraries: pixman-1

    if flag(build-tool-depends)
       build-tool-depends:
           hs-bindgen:hs-bindgen-cli

test-suite pixman-test
    import:           warnings
    default-language: GHC2024
    other-modules:    PixmanSpec
    type:             exitcode-stdio-1.0
    hs-source-dirs:   test
    main-is:          Spec.hs
    build-depends:
        base
      , pixman-bindings
      , deepseq
      , hspec
    build-tool-depends:
          hspec-discover:hspec-discover
