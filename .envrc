# shellcheck shell=bash

watch_file nix/*.nix cabal.project* ./*/*.cabal

export CABAL_DIR=${CABAL_DIR:-$HOME/.local/state/cabal}

cabal2 () {
    cabal --distdir=dist-newstyle2 "$@"
}
export_function cabal2

#use flake "#default"
#use flake "#legacyPackages.x86_64-linux.project-hnix.flake'.devShells.ghc912"
use flake "#legacyPackages.x86_64-linux.project.flake'.devShells.ghc912"
