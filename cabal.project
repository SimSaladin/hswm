packages:
  ./hs-bindgen-hooks
  ./hswm
  ./hswm-bindings
  ./pixman-bindings
  ./waybar-cffi-hs
  ./xkbcommon-bindings

extra-packages: generics-sop, lens-sop

jobs: $ncpus

verbose: 1

-- * Documentation

--documentation: True
--haddock-hoogle: True
--haddock-html: True
--haddock-html-location: https://hackage.haskell.org/packages/archive/$pkg/latest/doc/html
--haddock-internal: True
--haddock-hyperlink-source: True
--haddock-keep-temp-files: True

-- * Advanced global config options

--write-ghc-environment-files: always

-- repository head.hackage.ghc.haskell.org
--   url: https://ghc.gitlab.haskell.org/head.hackage/
--   secure: True
--   key-threshold: 3
--   root-keys:
--      f76d08be13e9a61a377a85e2fb63f4c5435d40f8feb3e12eb05905edb8cdea89
--      26021a13b401500c8eb2761ca95c61f2d625bfef951b939a8124ed12ecf07329
--      7541f32a4ccca4f97aea3b22f5e593ba2c0267546016b992dfadcd2fe944e55d
--   --sha256: sha256-tv3xym0AWegXTr5x1cx8Fgi4aNtwI35CF5TYrjWN4f8=

-- Temporary relaxes for GHC 9.14.1
if impl(ghc >= 9.14)
  allow-newer: cairo-0.13.12.0:Cabal
  allow-newer: cairo-0.13.12.0:time
  allow-newer: debruijn-0.3.1:base
  allow-newer: monad-control-1.0.3.1:transformers-compat
  allow-newer: optparse-generic-1.5.3:time
  allow-newer: optparse-generic-1.5.3:transformers-compat
  allow-newer: pango-0.13.12.0:Cabal
  allow-newer: pango-0.13.12.0:containers
  allow-newer: skew-list-0.1:QuickCheck
  allow-newer: skew-list-0.1:base
  allow-newer: typerep-map-0.7.0.0:base

