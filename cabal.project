index-state: 2026-11-20T03:46:37Z

packages:
  hswm
  hswm-bindings
  waybar-cffi-hs
  haskell-wayland-core
  pixman-bindings
  xkbcommon-bindings
  hs-bindgen-hooks

jobs: $ncpus
verbose: 0

-- local packages only
executable-stripping: True
library-stripping: True

-- documentation: True
haddock-html: True
haddock-hoogle: True
haddock-quickjump: True
haddock-hyperlink-source: True
haddock-use-unicode: True
--haddock-html-location: file:///packages/archive/$pkg/latest/doc/html

extra-packages: process

-- string-interpolate-1.0.0.0 depends on ghc-hs-meta, which causes issues
constraints: any.string-interpolate <1.0

--
-- Temporary relaxes for GHC 9.14.1
--

if impl(ghc >= 9.12)
  allow-newer: tagged
  allow-newer: skew-list-0.1:QuickCheck
  allow-newer: vec:QuickCheck
  allow-newer: fin:QuickCheck
  allow-newer: hspec-core:QuickCheck
  allow-newer: hs-bindgen:aeson
  allow-newer: optparse-generic-1.5.3:transformers-compat
  allow-newer: monad-control-1.0.3.1:transformers-compat

if impl(ghc >= 9.14)
  allow-newer: debruijn-0.3.1:base
  allow-newer: cairo-0.13.12.0:time
  allow-newer: pango-0.13.12.0:containers
  allow-newer: optparse-generic-1.5.3:time
  allow-newer: skew-list-0.1:base
  allow-newer: typerep-map-0.7.0.0:base


-- TO catch inxhaustive patterns...
package hswm
   ghc-options: -Wall -Werror
     -Wno-error=unused-packages
     -Wno-error=ambiguous-fields -Wno-ambiguous-fields
     -Wno-error=unused-matches
     -Wno-error=partial-type-signatures -Wno-partial-type-signatures
