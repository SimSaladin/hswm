packages:
  ./hs-bindgen-hooks
  ./hswm
  ./hswm-bindings
  ./pixman-bindings
  ./waybar-cffi-hs
  ./xkbcommon-bindings

jobs: $ncpus
optimization: False
verbose: 0
index-state: 2026-06-04T23:15:22Z

write-ghc-environment-files: never

-- local packages only
executable-stripping: True
library-stripping: True

haddock-hoogle: True
haddock-html: True
haddock-hyperlink-source: True
haddock-quickjump: True
open: true

-- for all packages
package *
   documentation: True

import: project-cabal/hs-bindgen.config
import: project-cabal/cabal-3.17.config

-- gtk2hs fixed for GHC 9.14.1 & Cabal-3.17
source-repository-package
  type: git
  location: https://github.com/SimSaladin/gtk2hs
  branch: cabal-3.17
  tag: 900fcd8aff7eb1c21b5b83e887cc35ec911d21ed
  subdir: cairo glib tools pango
  --sha256: 09kcp0vm0i703fllcny4ph2sa67d0gahr8wknr1vgrlyhwn0hff0

-- Temporary relaxes for GHC 9.14.1
if impl(ghc >= 9.14)
  allow-newer: cairo-0.13.12.0:time
  allow-newer: debruijn-0.3.1:base
  allow-newer: monad-control-1.0.3.1:transformers-compat
  allow-newer: optparse-generic-1.5.3:time
  allow-newer: optparse-generic-1.5.3:transformers-compat
  allow-newer: pango-0.13.12.0:containers
  allow-newer: skew-list-0.1:QuickCheck
  allow-newer: skew-list-0.1:base
  allow-newer: typerep-map-0.7.0.0:base
  allow-newer: hs-bindgen:aeson
