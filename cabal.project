index-state: 2026-07-10T00:04:30Z

packages:
  hswm
  hswm-bindings
  waybar-cffi-hs
  haskell-wayland-core
  pixman-bindings
  xkbcommon-bindings
  hs-bindgen-hooks

jobs: $ncpus
verbose: 0

-- local packages only
executable-stripping: True
library-stripping: True

-- documentation: True
haddock-html: True
haddock-hoogle: True
haddock-quickjump: True
haddock-hyperlink-source: True
haddock-use-unicode: True

-- haskell.nix only supports imports when they end in .cabal:
-- https://github.com/input-output-hk/haskell.nix/issues/2144
import: project-cabal/hs-bindgen.cabal
import: project-cabal/cabal-3.17.cabal

--
-- Temporary relaxes for GHC 9.14.1
--

if impl(ghc >= 9.14)
  allow-newer: debruijn-0.3.1:base
  allow-newer: cairo-0.13.12.0:time
  allow-newer: pango-0.13.12.0:containers
  allow-newer: monad-control-1.0.3.1:transformers-compat
  allow-newer: optparse-generic-1.5.3:time
  allow-newer: optparse-generic-1.5.3:transformers-compat
  allow-newer: skew-list-0.1:QuickCheck
  allow-newer: skew-list-0.1:base
  allow-newer: typerep-map-0.7.0.0:base
  allow-newer: hs-bindgen:aeson

write-ghc-environment-files: never
