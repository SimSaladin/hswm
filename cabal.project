packages:
  ./hs-bindgen-hooks
  ./hswm
  ./hswm-bindings
  ./pixman-bindings
  ./waybar-cffi-hs
  ./xkbcommon-bindings

extra-packages: generics-sop, lens-sop

--package haskell-language-server
--  flags: -fourmolu -cabal -class -callHierarchy -eval -importlens -rename
--    -retrie -hlint -signatureHelp -splice -qualifyImportedNames -codeRange
--    -changeTypeSignature -gadt -explicitFields -refactor -semanticTokens

jobs: $ncpus

verbose: 1

