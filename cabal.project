--    --sha256: 0dsj0r40lcdhnm71l5krvzcrddwjlv4qs42g6ay80ng7b51ps35z

if impl(ghc >= 9.14)
  allow-newer: typerep-map-0.7.0.0:base
  allow-newer: pango-0.13.12.0:containers
  allow-newer: pango-0.13.12.0:Cabal
  allow-newer: cairo-0.13.12.0:Cabal
  allow-newer: cairo-0.13.12.0:time
  allow-newer: monad-control-1.0.3.1:transformers-compat
  allow-newer: optparse-generic-1.5.3:transformers-compat
  allow-newer: optparse-generic-1.5.3:time
  allow-newer: debruijn-0.3.1:base
  allow-newer: skew-list-0.1:base
