packages:
  ./hswm
  ./hswm-bindings
  ./pixman-bindings
  ./waybar-cffi-hs
  ./xkbcommon-bindings
  ./hs-bindgen-hooks

package pixman-bindings
  flags: -hs-bindgen-build-tool
package hswm-bindings
  flags: -hs-bindgen-build-tool

verbose: 1
jobs: $ncpus
--index-state @1777539042

-- * Package configuration options

--optimization: 1
--debug-info: True
--executable-dynamic: True

-- * Documentation

--documentation: True
--haddock-hoogle: True
--haddock-html: True
--haddock-html-location: https://hackage.haskell.org/packages/archive/$pkg/latest/doc/html
--haddock-internal: True
--haddock-hyperlink-source: True
--haddock-keep-temp-files: True

-- * Advanced global config options

--write-ghc-environment-files: always

constraints: gtk2hs-buildtools >= 0.13.12.0
--    Cabal >= 3.17

source-repository-package
    type: git
    location: https://github.com/well-typed/libclang-bindings
    tag: 51b4b4972ea7ee8f7848f962e8524b6cd3eb4a84
    subdir: libclang-bindings
    --sha256: 0ah4fjl3mfacz1dgpcwmjlm5ay2c4khv5c54s28b6b5fhvv9zy3v

source-repository-package
    type: git
    location: https://github.com/well-typed/doxygen-parser
    tag: 33b5074eb5122062ac41fa8b9ed0596d39913b63
    --sha256: 0xj6lilgj70rs3fcc86gl30z5imghx9jgiwalvw9q8ldlpd7hvgc

source-repository-package
  type: git
  location: https://github.com/well-typed/hs-bindgen
  branch: master
  tag: 6227d5e86a392dd3bbdc963e4149a07f00032564
  subdir:
    hs-bindgen
    hs-bindgen-runtime
    c-expr-dsl
    c-expr-runtime
  --sha256: sha256-XaGqlUCDCIMTpiaJK8QDdk6tG3X9IxuWPD/OT/dOW/g=

source-repository-package
  type: git
  location: https://github.com/TuongNM/gtk2hs
  branch: ghc-rts-api
  tag: 16c4adcf5ec20dd7e0e52bf613249df5f43bffdb
  subdir: tools glib
  --sha256: 0x51gv80aqb9w6p5qgd1glxq90dynnvp84zy84k8b8fnkbcac2xq

--  source-repository-package
--    type: git
--    location: https://github.com/haskell/cabal
--    branch: master
--    tag: 03d6011f6cfda56e03271f00c4b0a455b00e76ed
