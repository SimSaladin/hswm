cabal-version:      3.0
name:               hs-bindgen-hooks
version:            0.1.0.0
-- synopsis:
-- description:
license:            BSD-3-Clause
license-file:       LICENSE
author:             Samuli Thomasson
maintainer:         samuli.thomasson@pm.me
-- copyright:
category:           Distribution
build-type:         Simple
extra-doc-files:    CHANGELOG.md
tested-with:
      GHC == 9.14.1
    , GHC == 9.12.4
    , GHC == 9.12.2

common warnings
    ghc-options:
       -Wall
       -Wunused-packages
       -Wno-ambiguous-fields

library
    import:           warnings
    exposed-modules:  Distribution.HsBindgen.Hooks
                      Distribution.HsBindgen.Utils
                      Distribution.HsBindgen.Types
                      Distribution.HsBindgen.Lens
                      Distribution.Wayland.Hooks
                      Distribution.Wayland.ProtocolXML
    reexported-modules:
        Distribution.Simple.SetupHooks
      , microlens:Lens.Micro
    build-depends:    base        >=4.21 && <5
                    , Cabal       >=3.14 && <3.18
                    , Cabal-hooks >=3.14 && <3.18
                    , containers  >=0.7  && <1.0
                    , data-default ^>=0.8.0
                    , directory ^>=1.3.9
                    -- , yaml >=0.11 && <0.12
                    , filepath >= 1.5 && <2
                    , microlens >= 0.4 && <1
                    , microlens-th >= 0.4 && <1
                    , microlens-ghc
                    , template-haskell >=2.20 && <3
                    , xml-conduit >=1.10 && <1.11
                    , text    ^>=2.1.2
                    , pretty
                    , string-interpolate
    hs-source-dirs:   src
    default-language: GHC2024
    default-extensions:
      DeriveAnyClass
      DuplicateRecordFields
      OverloadedRecordDot
      OverloadedStrings
      RecordWildCards
      StaticPointers
