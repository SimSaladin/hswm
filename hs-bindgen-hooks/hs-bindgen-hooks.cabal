cabal-version:      3.0
name:               hs-bindgen-hooks
version:            0.1.0.0
-- synopsis:
-- description:
license:            BSD-3-Clause
license-file:       LICENSE
author:             Samuli Thomasson
maintainer:         samuli.thomasson@pm.me
-- copyright:
category:           Distribution
build-type:         Simple
extra-doc-files:    CHANGELOG.md
-- extra-source-files:

common warnings
    ghc-options: -Wall

library
    import:           warnings
    exposed-modules:  Distribution.HsBindgen.Hooks
                      Distribution.HsBindgen.Utils
                      Distribution.HsBindgen.Lens
                      Distribution.Wayland.Hooks
                      Distribution.Wayland.ProtocolXML
    build-depends:    base        >=4.21 && <5
                    , Cabal       >=3.14 && <3.18
                    , Cabal-hooks >=3.14 && <3.18
                    , containers
                    , data-default
                    , yaml
                    , filepath
                    , microlens
                    , microlens-th
                    , template-haskell
                    , xml-conduit
                    , text
    hs-source-dirs:   src
    default-language: GHC2024
    default-extensions:
      DeriveAnyClass
      OverloadedRecordDot
      RecordWildCards
      StaticPointers
      DuplicateRecordFields
      OverloadedStrings
    ghc-options: -Wno-ambiguous-fields
