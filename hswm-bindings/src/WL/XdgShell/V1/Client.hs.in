

clientFromProtocolXML' commonSettings
  { prEventArgTypeTrans = \s iface ev arg t ->
    case (arg.argType, ev.name) of
      (AArray, "configure")       -> [t|WL.Util.Array $(conT $ mkName "ToplevelState")|]
      (AArray, "wm_capabilities") -> [t|WL.Util.Array $(conT $ mkName "ToplevelWmCapabilities")|]
      _                           -> defaultEventArgTypeTrans s iface ev arg t
  } protoXml
