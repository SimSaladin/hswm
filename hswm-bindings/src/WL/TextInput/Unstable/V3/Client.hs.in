
clientFromProtocolXML' commonSettings
  { prRequestArgTypeTrans = \s iface r arg t -> case arg.argType of
      AArray | r.name == "set_available_actions" -> [t| WL.Util.Array $(conT $ mkName "TextInputAction") |]
      _                                          -> defaultRequestArgTypeTrans s iface r arg t
  } protoXml
